    {
      "id": "sidebar-title",
      "type": "text",
      "x": 960,
      "y": 100,
      "width": 220,
      "height": 25,
      "text": "Tracing Hierarchy (Consumer)",
      "fontSize": 14,
      "fontFamily": 5,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null
    },
    {
      "id": "sidebar-text",
      "type": "text",
      "x": 960,
      "y": 130,
      "width": 220,
      "height": 400,
      "text": "Span: process_message\n  Attributes:\n  - payment_id\n  - partition\n  - offset\n  - messaging.system\n  - messaging.destination\n  - messaging.consumer_group\n\n├── Span: validator.validate\n├── Span: idempotency.is_processed\n├── Span: idempotency.mark_processed\n├── Span: retry.do\n│   ├── Span: status.update\n│   └── Span: history.record\n└── Span: dlq.publish\n    (only on failure)\n\nMetrics (6 counters):\n- messages_received\n- messages_processed\n- processing_duration (hist)\n- retry_attempts\n- dlq_published\n- idempotency_hits",
      "fontSize": 10,
      "fontFamily": 5,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null
    },
    {
      "id": "logs-section",
      "type": "text",
      "x": 960,
      "y": 565,
      "width": 220,
      "height": 175,
      "text": "Logs (slog JSON):\n\n{\n  \"time\": \"...\",\n  \"level\": \"WARN\",\n  \"msg\": \"retry failed\",\n  \"service\": \"payment-\n   consumer\",\n  \"payment_id\": \"abc\",\n  \"attempt\": 2,\n  \"trace_id\": \"...\"\n}\n\nNo sensitive data logged.\nStack traces excluded.",
      "fontSize": 10,
      "fontFamily": 5,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null
    }
