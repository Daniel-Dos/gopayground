    {
      "id": "eventbus-detail-text",
      "type": "text",
      "x": 460,
      "y": 520,
      "width": 620,
      "height": 50,
      "text": "Package: internal/ui/events.go\n- redis.Subscribe to channel \"payment:events\"\n- In-memory subscribers: map[string]chan *models.PaymentEvent\n- Non-blocking send: drops event if buffer full (log warning)\n- Close() cancels all subscriber goroutines",
      "fontSize": 13,
      "fontFamily": 5,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null
