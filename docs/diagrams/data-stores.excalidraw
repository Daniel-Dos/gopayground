      "id": "legend-title",
      "type": "text",
      "x": 740,
      "y": 108,
      "width": 160,
      "height": 20,
      "text": "Data Flow Summary",
      "fontSize": 14,
      "fontFamily": 5,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null
    },
    {
      "id": "legend-text",
      "type": "text",
      "x": 740,
      "y": 130,
      "width": 160,
      "height": 100,
      "text": "Consumer writes to:\n 1. Redis Status (HSET)\n 2. Redis Idempotency (SET NX)\n 3. DynamoDB History (PutItem)\n\nConsumer reads from:\n - Redis Idempotency (GET)\n\nUI reads from:\n - Redis Status (SCAN+HGETALL)\n - DynamoDB History (Query)",
      "fontSize": 11,
      "fontFamily": 5,
      "strokeColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null
    }
