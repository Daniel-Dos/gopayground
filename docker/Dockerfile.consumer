FROM golang:1.26-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /app/consumer ./cmd/consumer

FROM alpine:3.19

RUN apk add --no-cache ca-certificates && \
    adduser -D -u 65532 appuser

WORKDIR /app

COPY --from=builder /app/consumer .
COPY config.yaml .

USER 65532

EXPOSE 8080

CMD ["/app/consumer"]
