FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Copy docs into static/ for embedding in the Go binary
RUN mkdir -p internal/ui/static/docs && cp -r docs/* internal/ui/static/docs/ 2>/dev/null || true

RUN CGO_ENABLED=0 GOOS=linux go build -o /app/ui ./cmd/ui

FROM alpine:3.19

RUN apk add --no-cache ca-certificates && \
    adduser -D -u 65532 appuser

WORKDIR /app

COPY --from=builder /app/ui .
COPY config.yaml .

USER 65532

EXPOSE 8081

CMD ["/app/ui"]
